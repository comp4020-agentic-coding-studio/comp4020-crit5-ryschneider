---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gravity Hop — COMP4020 prototype</title>
    <meta
      name="description"
      content="A tiny gravity-hopping platformer: jump between small planets, each pulling you toward its own surface, to reach the far one before you drift into space."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <header>
      <nav aria-label="Primary"></nav>
    </header>
    <main>
      <h1>Gravity Hop</h1>
      <canvas id="game" width="960" height="540"></canvas>
    </main>
    <script src="../game/main.ts"></script>
  </body>
</html>
